data/mnist/
data/MNIST/

# Saved models (keep directory with .gitkeep)
saved_models/*.pth
saved_models/*.pt

# Output plots (keep directory with .gitkeep)
outputs/
!outputs/.gitkeep

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
sdist/
wheels/

# Environment files
.env
.env.local

# PyTorch / training artifacts
runs/
logs/
*.onnx

