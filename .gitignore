.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover

# NOTE: .gitkeep files are empty placeholder files placed inside directories
# that would otherwise be empty. Git does not track empty directories, so
# .gitkeep ensures the directory structure is preserved in the repository.
# Add .gitkeep to: data/, saved_models/, outputs/
